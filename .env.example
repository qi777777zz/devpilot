DEVPILOT_DATABASE_URL=sqlite:///./var/devpilot.db
DEVPILOT_ALLOWED_REPOSITORY_ROOT=.
DEVPILOT_ENABLE_LOCAL_EXECUTION=false
DEVPILOT_TEST_TIMEOUT_SECONDS=120
DEVPILOT_IN_PROCESS_WORKER=true
DEVPILOT_WORKER_POLL_SECONDS=1.0
DEVPILOT_WORKER_LEASE_SECONDS=30
DEVPILOT_WORKER_MAX_ATTEMPTS=3
DEVPILOT_CONTEXT_TOKEN_BUDGET=3000
DEVPILOT_WORKSPACE_STORAGE_ROOT=var/workspaces
DEVPILOT_PATCH_MAX_BYTES=200000
DEVPILOT_PATCH_MAX_FILES=20
